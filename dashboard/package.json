{
  "name": "smartharness-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Mission 4: MQTT monitoring and SQLite event history",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "demo": "node scripts/publish-demo.js",
    "build:flows": "node scripts/build-flows.js"
  },
  "dependencies": {
    "@flowfuse/node-red-dashboard": "1.34.1",
    "mqtt": "5.16.1",
    "node-red": "5.0.9",
    "node-red-node-sqlite": "2.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.3"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
