  {
    "id": "dashboard-ui",
    "type": "ui-template",
    "z": "mission4",
    "name": "Circuits et historique",
    "x": 480,
    "y": 690,
    "group": "ui-group",
    "page": "",
    "ui": "",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <main class=\"sh\" v-if=\"msg && msg.payload\">\n    <header><div><p class=\"eyebrow\">SMARTHARNESS · MISSION 4</p><h1>Diagnostic du faisceau</h1><p>Derniers événements reçus · ECU A et ECU B</p></div><span class=\"pill\">{{ data.total }} réceptions enregistrées</span></header>\n    <section class=\"connections\">\n      <div><small>Connexion MQTT</small><strong :class=\"data.mqtt === 'connected' ? 'good' : 'bad'\">{{ data.mqtt === 'connected' ? 'Connecté' : 'Déconnecté' }}</strong></div>\n      <div><small>Gateway</small><strong>{{ data.gateway === 'online' ? 'En ligne' : data.gateway === 'offline' ? 'Hors ligne' : 'Inconnu' }}</strong></div>\n      <div><small>Base SQLite</small><strong :class=\"data.database === 'ready' ? 'good' : 'bad'\">{{ data.database === 'ready' ? 'Disponible' : data.database }}</strong></div>\n      <div><small>Présence des ECU</small><strong>Non déterminée</strong></div>\n    </section>\n    <p class=\"notice\">Le Gateway ne confirme pas la présence des ECU. Les tensions sont celles des derniers événements, pas des mesures continues.</p>\n    <section class=\"summary\" aria-label=\"Résumé des derniers diagnostics\">\n      <div class=\"summary-item summary-fault\"><span class=\"summary-number\" data-summary=\"fault\">{{ summary.fault }}</span><div><strong>Circuits en panne</strong><small>Dernier diagnostic : panne active</small></div></div>\n      <div class=\"summary-item summary-recovered\"><span class=\"summary-number\" data-summary=\"recovered\">{{ summary.recovered }}</span><div><strong>Résolutions reçues</strong><small>État de santé ECU non vérifié</small></div></div>\n      <div class=\"summary-item summary-unknown\"><span class=\"summary-number\" data-summary=\"unknown\">{{ summary.unknown }}</span><div><strong>États inconnus</strong><small>Aucun diagnostic dans cette exécution</small></div></div>\n    </section>\n    <p class=\"notice summary-caption\">Répartition des quatre circuits selon leur dernier événement enregistré, même si la communication n’est plus confirmée. Ce ne sont pas des compteurs d’événements.</p>\n    <div role=\"alert\" class=\"error\" v-if=\"data.last_error\">Dernière anomalie : {{ data.last_error }} · Messages rejetés : {{ data.rejected }} · Écritures échouées : {{ data.failed_writes }}</div>\n    <section class=\"circuits\">\n      <article v-for=\"c in data.circuits\" :key=\"c.circuit\" :class=\"['circuit', c.status.toLowerCase()]\">\n        <small>ECU {{ c.ecu }} · CIRCUIT {{ c.circuit }}</small><h2>{{ c.name }}</h2>\n        <strong class=\"diagnosis\"><span class=\"status-symbol\" aria-hidden=\"true\">{{ c.status === 'UNKNOWN' ? '?' : c.status === 'RECOVERED' ? '✓' : '!' }}</span>{{ label(c.status) }}</strong>\n        <template v-if=\"c.last\">\n          <p class=\"measurement\">{{ c.last.voltage_mv }} <span>mV · commande {{ c.last.command_on ? 'ON' : 'OFF' }}</span></p>\n          <small>Reçu : {{ time(c.last.received_at) }}</small>\n          <p class=\"health-note\" v-if=\"c.status === 'RECOVERED'\">Résolution signalée par l’ECU ; sa présence et sa santé actuelles ne sont pas vérifiées.</p>\n          <p class=\"notice\" v-if=\"c.stale\">Dernier état connu · communication non confirmée</p>\n        </template>\n        <p v-else>Aucun événement reçu pendant cette exécution.</p>\n        <small v-if=\"!c.last && c.historical\">Archive : {{ c.historical.active ? 'panne active' : 'résolution' }}, reçue {{ time(c.historical.received_at) }}. État actuel inconnu.</small>\n      </article>\n    </section>\n    <section class=\"history\"><div class=\"history-title\"><h2>Historique des diagnostics</h2><label>Circuit <select v-model=\"filter\"><option value=\"all\">Tous</option><option v-for=\"c in data.circuits\" :value=\"String(c.circuit)\">{{ c.name }}</option></select></label></div>\n      <p>200 dernières réceptions · horodatage UTC à la réception par Node-RED, pas à l’apparition de la panne. Les répétitions sont conservées.</p>\n      <div class=\"table-scroll\"><table><thead><tr><th>N°</th><th>Réception UTC</th><th>ECU / circuit</th><th>Diagnostic</th><th>Tension</th><th>Commande</th><th>Séquence</th></tr></thead><tbody>\n        <tr v-for=\"row in rows\" :key=\"row.event_id\"><td>{{ row.event_id }}</td><td>{{ time(row.received_at) }}</td><td>{{ row.ecu }} / {{ row.circuit }}</td><td><span :class=\"['event-badge', row.active ? 'event-fault' : 'event-recovered']\">{{ row.fault_code === 0 ? 'Résolution reçue' : row.fault_code === 1 ? 'Déconnexion' : 'Intermittence (code 2)' }}</span></td><td>{{ row.voltage_mv }} mV</td><td>{{ row.command_on ? 'ON' : 'OFF' }}</td><td>{{ row.seq }}</td></tr>\n        <tr v-if=\"!rows.length\"><td colspan=\"7\">Aucun événement enregistré pour ce filtre.</td></tr>\n      </tbody></table></div>\n    </section>\n  </main>\n  <p v-else>Chargement du diagnostic…</p>\n</template>\n<script>\nexport default {\n  data() { return { filter: 'all' }; },\n  computed: {\n    data() { return this.msg.payload; },\n    summary() {\n      return this.data.circuits.reduce((counts, circuit) => {\n        if (circuit.status === 'FAULT' || circuit.status === 'INTERMITTENT') counts.fault++;\n        else if (circuit.status === 'RECOVERED') counts.recovered++;\n        else counts.unknown++;\n        return counts;\n      }, { fault: 0, recovered: 0, unknown: 0 });\n    },\n    rows() { return this.data.history.filter(r => this.filter === 'all' || String(r.circuit) === this.filter); }\n  },\n  methods: {\n    label(value) { return {UNKNOWN:'INCONNU', FAULT:'PANNE · déconnexion', INTERMITTENT:'PANNE · intermittence', RECOVERED:'RÉSOLUTION REÇUE'}[value]; },\n    time(value) { return value ? value.replace('T', ' ').replace('Z', ' UTC') : '—'; }\n  }\n};\n</script>\n<style>\n.sh { --red:#ad1825; --green:#116440; --ink:#172b42; font:18px/1.5 system-ui,sans-serif; color:var(--ink); width:100%; min-width:0; box-sizing:border-box; padding:clamp(12px,1.3vw,32px); margin:0; }\n.nrdb-ui-template { min-width:0; }\n.sh *, .sh *::before, .sh *::after { box-sizing:border-box; }\n.sh header, .sh .history-title { display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap; }\n.sh header>div { min-width:0; }\n.sh h1 { font-size:clamp(30px,2.1vw,48px); line-height:1.15; letter-spacing:-1px; margin:8px 0; }\n.sh .eyebrow { font-size:15px; font-weight:750; letter-spacing:2px; color:#246c61; }\n.sh header p { margin:8px 0; }\n.sh .pill { border-radius:30px; background:#e4f1ee; padding:12px 22px; color:#17584e; font-size:18px; font-weight:650; }\n.sh .connections { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px; background:#eaf0f5; padding:22px 26px; border-radius:14px; margin:24px 0 10px; }\n.sh .connections strong, .sh .connections small { display:block; }\n.sh .connections small { margin-bottom:5px; font-size:16px; }\n.sh .connections strong { font-size:22px; }\n.sh .good { color:var(--green); } .sh .bad { color:var(--red); }\n.sh .notice, .sh .history>p { font-size:16px; color:#4d6074; line-height:1.5; }\n.sh .summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin:24px 0 8px; }\n.sh .summary-item { display:flex; align-items:center; gap:20px; border:1px solid; border-radius:14px; padding:18px 24px; }\n.sh .summary-fault { background:#fff0f1; border-color:#efb6bc; color:var(--red); }\n.sh .summary-recovered { background:#eaf7ef; border-color:#b2d9c2; color:var(--green); }\n.sh .summary-unknown { background:#edf1f6; border-color:#c4ceda; color:#465b72; }\n.sh .summary-number { font-size:48px; line-height:1; font-weight:800; font-variant-numeric:tabular-nums; }\n.sh .summary-item strong { display:block; font-size:21px; }\n.sh .summary-item small { display:block; font-size:15px; }\n.sh .summary-caption { margin:8px 0 22px; }\n.sh .circuits { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:22px; margin:22px 0 28px; }\n.sh .circuit { min-width:0; border:1px solid #cbd5e1; border-top:7px solid #7c8da3; border-radius:14px; padding:24px; background:#fff; overflow-wrap:anywhere; }\n.sh .circuit h2 { font-size:clamp(24px,1.55vw,34px); line-height:1.25; margin:10px 0 22px; }\n.sh .circuit small { font-size:15px; }\n.sh .diagnosis { display:flex; align-items:center; gap:10px; font-size:18px; line-height:1.35; padding:12px; border-radius:9px; background:#edf1f6; margin-bottom:18px; }\n.sh .status-symbol { display:inline-flex; align-items:center; justify-content:center; flex:0 0 30px; height:30px; border-radius:50%; background:#52647a; color:white; font-size:22px; font-weight:800; }\n.sh .fault, .sh .intermittent { border-color:#df9ca4; border-top-color:var(--red); background:#fff8f8; }\n.sh .fault .diagnosis, .sh .intermittent .diagnosis { color:var(--red); background:#fbe2e5; }\n.sh .fault .status-symbol, .sh .intermittent .status-symbol { background:var(--red); }\n.sh .recovered { border-top-color:var(--green); }\n.sh .recovered .diagnosis { color:var(--green); background:#e4f3e9; }\n.sh .recovered .status-symbol { background:var(--green); }\n.sh .measurement { font-size:30px; font-weight:700; margin:14px 0 8px; }\n.sh .measurement span { font-size:16px; font-weight:500; }\n.sh .health-note { font-size:15px; color:#4d6074; margin:12px 0 0; }\n.sh .circuit .notice { background:#fff5df; border-left:3px solid #b48224; padding:9px 12px; font-size:15px; margin-top:12px; }\n.sh .history { min-width:0; max-width:100%; background:white; border:1px solid #cbd5e1; border-radius:14px; padding:24px; }\n.sh .history h2 { font-size:28px; margin:0 0 8px; }\n.sh .history select { border:1px solid #8e9eb1; border-radius:8px; padding:9px 12px; margin-left:10px; font-size:17px; background:white; color:var(--ink); }\n.sh .table-scroll { max-height:540px; max-width:100%; overflow:auto; margin-top:14px; }\n.sh table { width:100%; border-collapse:collapse; font-size:17px; white-space:nowrap; }\n.sh th, .sh td { text-align:left; padding:14px 16px; border-bottom:1px solid #e1e6ec; }\n.sh th { background:#eaf0f5; position:sticky; top:0; z-index:1; }\n.sh tbody tr:nth-child(even) { background:#f7f9fb; }\n.sh .event-badge { display:inline-block; border-radius:6px; padding:4px 10px; font-size:16px; font-weight:650; }\n.sh .event-fault { background:#fbe2e5; color:var(--red); }\n.sh .event-recovered { background:#e4f3e9; color:var(--green); }\n.sh .error { padding:16px; border-left:5px solid var(--red); background:#ffeded; color:#8d2020; margin:16px 0; }\n@media(min-width:2200px) { .sh { font-size:20px; } .sh .circuit { padding:30px; } .sh .diagnosis { font-size:22px; } .sh table { font-size:19px; } }\n@media(max-width:1200px) { .sh .circuits, .sh .connections { grid-template-columns:repeat(2,minmax(0,1fr)); } .sh .summary-item { padding:16px; gap:12px; } .sh .summary-item strong { font-size:18px; } }\n@media(max-width:700px) { .sh { font-size:16px; padding:10px; } .sh .circuits, .sh .connections, .sh .summary { grid-template-columns:1fr; } .sh .circuit, .sh .history, .sh .connections { padding:18px; } .sh .history h2 { font-size:24px; } .sh .pill { font-size:16px; } .sh table { font-size:15px; } }\n</style>\n",
