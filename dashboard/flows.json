  {
    "id": "mqtt-state-update",
    "type": "function",
    "z": "mission4",
    "name": "Ne pas confondre MQTT et ECU",
    "x": 480,
    "y": 240,
    "func": "const s=global.get('shState'); const sh=global.get('sh');\n\nconst connected=msg.status.text==='node-red:common.status.connected'||msg.status.text==='connected';\ns.mqtt=connected?'connected':'disconnected';\nif(!connected) { s.gateway='unknown'; s.circuits.forEach(c=>c.fresh=false); }\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
  {
