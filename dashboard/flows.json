    "func": "const s=global.get('shState'); const sh=global.get('sh');\n\ns.database='error'; s.last_error='SQLite : '+(msg.error?.message||'erreur inconnue');\nnode.warn(s.last_error);\nif(msg.error?.source?.id==='insert') { s.failed_writes++; s.writing=false; return sh.nextWrite(s); }\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
