      ]
    ]
  },
  {
    "id": "insert",
    "type": "sqlite",
    "z": "mission4",
    "name": "Enregistrer chaque réception",
    "x": 720,
    "y": 330,
    "mydb": "db",
    "sqlquery": "prepared",
    "sql": "INSERT INTO fault_events (received_at,topic,ecu,circuit,fault_code,active,voltage_mv,command_on,seq) VALUES ($received_at,$topic,$ecu,$circuit,$fault_code,$active,$voltage_mv,$command_on,$seq)",
    "wires": [
      [
        "stored"
      ]
    ]
  },
  {
    "id": "stored",
    "type": "function",
    "z": "mission4",
    "name": "Confirmer seulement après écriture",
    "x": 960,
    "y": 330,
    "func": "const s=global.get('shState'); const sh=global.get('sh');\n\ns.database='ready'; sh.acceptStored(s,msg.event,msg.received_at); s.writing=false;\nreturn [sh.nextWrite(s),{}];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "insert"
      ],
      [
        "read-history"
      ]
    ]
  },
  {
    "id": "read-history",
    "type": "sqlite",
    "z": "mission4",
    "name": "Relire les archives et le total",
    "x": 240,
    "y": 420,
    "mydb": "db",
    "sqlquery": "fixed",
    "sql": "SELECT *, (SELECT COUNT(*) FROM fault_events) AS total_count FROM fault_events WHERE event_id IN (SELECT event_id FROM fault_events ORDER BY event_id DESC LIMIT 200) OR event_id IN (SELECT MAX(event_id) FROM fault_events GROUP BY circuit) ORDER BY event_id DESC",
    "wires": [
      [
        "history"
      ]
    ]
  },
  {
    "id": "history",
    "type": "function",
    "z": "mission4",
    "name": "Archives distinctes de l’état actuel",
    "x": 480,
    "y": 420,
    "func": "const s=global.get('shState'); const sh=global.get('sh');\nsh.restoreHistory(s,msg.payload); return null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
