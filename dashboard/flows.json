  {
    "id": "initialized",
    "type": "function",
    "z": "mission4",
    "name": "Base prête, vider la file de démarrage",
    "x": 480,
    "y": 330,
    "func": "const s=global.get('shState'); const sh=global.get('sh');\n\ns.ready=true; s.database='ready';\nreturn [sh.nextWrite(s),{}];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
