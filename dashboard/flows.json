  {
    "id": "validate",
    "type": "function",
    "z": "mission4",
    "name": "Valider et dater la réception",
    "x": 720,
    "y": 150,
    "func": "const s=global.get('shState'); const sh=global.get('sh');\n\ntry { msg.event=sh.validateEvent(msg.topic,msg.payload); }\ncatch(e) { s.rejected++; s.last_error=e.message; node.warn(e.message); return null; }\nmsg.received_at=new Date().toISOString();\nmsg.params={$received_at:msg.received_at,$topic:msg.topic};\nfor(const [key,value] of Object.entries(msg.event)) msg.params['$'+key]=typeof value==='boolean'?Number(value):value;\nif(s.pending.length>=256) {\n  s.failed_writes++; s.last_error='File SQLite pleine : réception non enregistrée'; node.warn(s.last_error);\n  return null;\n}\ns.pending.push(msg);\nreturn sh.nextWrite(s);",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "insert"
      ]
    ]
  },
  {
    "id": "gateway-status",
    "type": "function",
    "z": "mission4",
    "name": "Statut du Gateway uniquement",
    "x": 960,
    "y": 150,
    "func": "const s=global.get('shState'); const sh=global.get('sh');\n\ntry { s.gateway=sh.validateStatus(msg.payload); s.gateway_received_at=new Date().toISOString(); if(s.gateway==='offline') s.circuits.forEach(c=>c.fresh=false); }\ncatch(e) { s.rejected++; s.last_error=e.message; node.warn(e.message); }\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
  {
    "id": "mqtt-state",
    "type": "status",
    "z": "mission4",
